      "isDeleted": false,
      "boundElements": null,
      "updated": 1783243591423,
      "link": null,
      "locked": false,
      "text": "A -> 1\nB -> 1\nC -> 1\n\nk = 3\nr - l + 1 <=k",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A -> 1\nB -> 1\nC -> 1\n\nk = 3\nr - l + 1 <=k",
      "autoResize": true,
      "lineHeight": 1.25
    },
