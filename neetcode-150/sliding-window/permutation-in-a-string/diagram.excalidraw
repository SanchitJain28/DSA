    {
      "id": "5g4IpNBgbLos3etLTqSc4",
      "type": "text",
      "x": 14.60315479209342,
      "y": 240.59383965150923,
      "width": 254.46531677246094,
      "height": 359.7069396972656,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 255662219,
      "version": 454,
      "versionNonce": 252969893,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783244811383,
      "link": null,
      "locked": false,
      "text": "1. sliding window and a map will \nbe used to store the frequency \nof chracters\n\n2. run a for loop to store\nthe frequencies of s1 and k , \nwhere k is the lenght of window \nk = s1.length\n\n3. now use left and right \npointer to define a window \n\n4. shrink if r - l + 1 <=k is false\n\n5. if we delete the element if it \nbecomes 0 , then it will be hard\nto identify the original elements\n",
      "fontSize": 15.98697509765625,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. sliding window and a map will \nbe used to store the frequency \nof chracters\n\n2. run a for loop to store\nthe frequencies of s1 and k , \nwhere k is the lenght of window \nk = s1.length\n\n3. now use left and right \npointer to define a window \n\n4. shrink if r - l + 1 <=k is false\n\n5. if we delete the element if it \nbecomes 0 , then it will be hard\nto identify the original elements\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TFuFrqm3qU1CzJNmxgVGt",
      "type": "text",
      "x": 311.65926775658465,
      "y": 316.83999891117145,
      "width": 90.52789306640625,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
