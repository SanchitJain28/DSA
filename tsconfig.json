{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react",
    "moduleResolution": "bundler"
  },
  "include": ["./"]
}
